CREATE TABLE MealSlotToggleEntity (
    day TEXT NOT NULL,
    mealSlot TEXT NOT NULL,
    enabled INTEGER NOT NULL,
    PRIMARY KEY (day, mealSlot)
);

upsert:
INSERT OR REPLACE INTO MealSlotToggleEntity(day, mealSlot, enabled) VALUES (?, ?, ?);

selectAll:
SELECT * FROM MealSlotToggleEntity ORDER BY day, mealSlot;

deleteAll:
DELETE FROM MealSlotToggleEntity;
