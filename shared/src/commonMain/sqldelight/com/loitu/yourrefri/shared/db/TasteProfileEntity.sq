CREATE TABLE taste_profile (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    flavors TEXT NOT NULL DEFAULT '',
    dish_styles TEXT NOT NULL DEFAULT '',
    avoid_ingredient_ids TEXT NOT NULL DEFAULT '',
    has_young_kids INTEGER NOT NULL DEFAULT 0
);

selectTasteProfile:
SELECT * FROM taste_profile WHERE id = 1;

upsertTasteProfile:
INSERT OR REPLACE INTO taste_profile(
    id, flavors, dish_styles, avoid_ingredient_ids, has_young_kids
)
VALUES (:id, :flavors, :dish_styles, :avoid_ingredient_ids, :has_young_kids);

deleteAll:
DELETE FROM taste_profile;
