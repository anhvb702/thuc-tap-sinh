CREATE TABLE LeftoverEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    compartment TEXT NOT NULL DEFAULT 'CHILL',
    markedAtEpochDays INTEGER NOT NULL,
    shelfDays INTEGER NOT NULL DEFAULT 2
);

selectAll:
SELECT * FROM LeftoverEntity ORDER BY markedAtEpochDays ASC, id ASC;

upsert:
INSERT OR REPLACE INTO LeftoverEntity(id, title, compartment, markedAtEpochDays, shelfDays)
VALUES (:id, :title, :compartment, :markedAtEpochDays, :shelfDays);

deleteById:
DELETE FROM LeftoverEntity WHERE id = :id;

deleteAll:
DELETE FROM LeftoverEntity;
